# ===== 工单管理平台 环境变量 =====
# 复制为 .env 并填写真实值

# ---- 应用 ----
APP_NAME=工单管理平台
APP_ENV=development            # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs                 # 文件日志目录：app.log（全量）+ error.log（ERROR 起），相对 backend 运行目录
LOG_RETENTION_DAYS=30        # 按天滚动保留天数
LOG_TO_STDERR=true           # 是否同时打到终端
# 前端访问基地址（拼钉钉工作通知卡片「查看工单」跳转链接；本地 5173，生产填你的域名）
FRONTEND_BASE_URL=http://localhost:5173

# ---- 数据库 (RDS PostgreSQL / 本地 PG) ----
# 生产环境用 RDS 内网连接串
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wo_closed_loop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis (Tair / 本地 Redis) ----
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
SESSION_COOKIE_NAME=wo_session

# ---- 对外开放 API（外部系统/Agent 以 X-API-Key 建单/查询工单）----
# 为空则禁用外部接口；生成：openssl rand -hex 32
EXTERNAL_API_KEY=

# ---- 钉钉 ----
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=             # 企业内部应用 AgentId（工作通知 asyncsend_v2 用；空则工作通知发不出）
DINGTALK_ROBOT_WEBHOOK=        # 群机器人 webhook（robot_mention 通道；钉钉群→机器人→安全设置 拿）
DINGTALK_ROBOT_SECRET=         # 群机器人加签 secret（未开加签则留空）
DINGTALK_ROBOT_CODE=           # 企业内部机器人 robotCode（发群消息 groupMessages/send；本项目 == AppKey）
DINGTALK_NOTIFY_GROUP_ID=      # 派发提醒目标群 openConversationId（合并发群进这个群）
DINGTALK_FALLBACK_USERID=      # 找不到责任人时的兜底 @ 对象（钉钉 userId；本项目=刘冰）
ALERT_ENABLED=true             # 错误告警开关
ALERT_NOTIFY_USERID=           # 告警接收人 userId；空则回落上面的 FALLBACK_USERID
ALERT_DEBOUNCE_SECONDS=300     # 同类告警防抖窗口（秒）
DINGTALK_OA_TEMPLATE_ID=      # 工单闭环审批模板 processCode（在钉钉管理后台创建后获取）
DINGTALK_CORP_ID=
DINGTALK_CALLBACK_TOKEN=      # 事件订阅 Token（钉钉开放平台 → 事件订阅 生成）
DINGTALK_CALLBACK_AES_KEY=    # 事件订阅 AES Key（43位Base64，钉钉开放平台生成）

# ---- OSS 附件存储 (Phase 2 填) ----
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- LLM (百炼 / 通义千问，Phase 4 填) ----
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 异常指标同步起跑日（YYYY-MM-DD，空=立即）。例：2026-09-12 表示 09-12 起才跑，之前 skip（用于先配好默认责任人）----
ANOMALY_SYNC_START_DATE=
# 异常指标增量同步轮询间隔（秒，默认 300=5分钟；本地 dev sync_poller / 生产 Celery beat 同用）
ANOMALY_SYNC_INTERVAL=300

# ---- 年度运营计划「初稿」轮询同步（非EAM 计划工单，source=plan）----
# 初稿文件夹 alidocs 节点 id（钉盘「Agent运营计划初稿（待判定会及确认工单）」，与定稿夹同 space 26687726819；只扫文件名含「工单版」的文件）
DRIVE_DRAFT_PLAN_FOLDER_ID=b9Y4gmKWrPqYGdg9i4y44M2AJGXn6lpz
# 计划初稿轮询间隔（秒，默认 3600=1小时；下载解析整批 xlsx 较重，勿设太短）
PLAN_SYNC_INTERVAL=3600

# ---- 主动巡检（静默失效扫描：待派发缺必填/同步中断/钉钉Stream断开 等）----
SWEEP_ENABLED=true
SWEEP_INTERVAL=600
