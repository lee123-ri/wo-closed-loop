# ===== 软工单闭环管理系统 环境变量 =====
# 复制为 .env 并填写真实值

# ---- 应用 ----
APP_NAME=软工单闭环管理系统
APP_ENV=development            # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- 数据库 (RDS PostgreSQL / 本地 PG) ----
# 生产环境用 RDS 内网连接串
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wo_closed_loop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis (Tair / 本地 Redis) ----
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
SESSION_COOKIE_NAME=wo_session

# ---- 钉钉 ----
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_OA_TEMPLATE_ID=      # 软工单闭环审批模板 processCode（在钉钉管理后台创建后获取）
DINGTALK_CORP_ID=
DINGTALK_CALLBACK_TOKEN=      # 事件订阅 Token（钉钉开放平台 → 事件订阅 生成）
DINGTALK_CALLBACK_AES_KEY=    # 事件订阅 AES Key（43位Base64，钉钉开放平台生成）

# ---- OSS 附件存储 (Phase 2 填) ----
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- LLM (百炼 / 通义千问，Phase 4 填) ----
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
