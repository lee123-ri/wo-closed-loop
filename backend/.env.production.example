# 生产环境配置模板 — 复制为实际注入的 Secret/环境变量，逐项替换
# 对应 docs/DEPLOYMENT.md 第 3 步

# ── 基础 ─────────────────────────────────────────────
APP_ENV=production
# 生产环境禁止自动灌演示数据（代码层也有硬拦截）
AUTO_SEED=false
# 前端访问基地址（钉钉工作通知卡片「查看工单」跳转用，填你的正式域名）
FRONTEND_BASE_URL=https://<你的域名>

# ── 数据库 / 缓存（阿里云内网地址）──────────────────
DATABASE_URL=postgresql+psycopg://wo:<密码>@<RDS内网地址>:5432/wo_closed_loop
REDIS_URL=redis://<Tair内网地址>:6379/0

# ── 鉴权 ─────────────────────────────────────────────
# 生成：openssl rand -hex 32
JWT_SECRET=<随机64字符>

# ── 对外开放 API（外部系统/Agent 以 X-API-Key 建单/查询工单）──
# 为空则禁用；生成：openssl rand -hex 32
EXTERNAL_API_KEY=<随机32字节hex>

# ── 钉钉 ─────────────────────────────────────────────
DINGTALK_APP_KEY=<AppKey>
DINGTALK_APP_SECRET=<AppSecret>
# 企业内部应用 AgentId（工作通知 topapi/message/corpconversation/asyncsend_v2 用；须在钉钉后台给应用申请「工作通知」消息权限）
DINGTALK_AGENT_ID=<AgentId>
# 群机器人 webhook（robot_mention 通道；钉钉群→机器人→安全设置；未用群机器人可留空）
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
# 企业内部机器人 robotCode（发群提醒；本项目 robotCode==AppKey）
DINGTALK_ROBOT_CODE=<robotCode>
DINGTALK_NOTIFY_GROUP_ID=<目标群 openConversationId>
DINGTALK_OA_TEMPLATE_ID=PROC-xxxx
DINGTALK_CORP_ID=<企业 corpId>
# 钉钉 OAuth 登录回跳地址（前端登录页）；必须线上 HTTPS 域名并在钉钉后台「安全设置-回调域名」登记
DINGTALK_LOGIN_REDIRECT_URI=https://<你的域名>/login
# 事件订阅 HTTP 回调加解密（走轮询兜底时可为空）
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=

# ── 登录策略 ─────────────────────────────────────────
LOGIN_ADMIN_ONLY=true       # 钉钉登录仅管理员放行；全员开放时置 false
NAME_LOGIN_ENABLED=false    # 姓名登录（无口令）默认关
DEV_LOGIN_ENABLED=false     # 开发登录；生产恒关
# 外部源默认只采集到数据池，管理员逐条勾选后才生成工单；确有自动化授权时才改 true
AUTO_WORKORDER_IMPORT_ENABLED=false
# 历史批量导入唯一授权人：填李沛东已绑定的钉钉 userId；留空则入口和接口均关闭
BULK_IMPORT_OWNER_DINGTALK_ID=

# ── CORS（你的前端域名，逗号分隔）───────────────────
CORS_ORIGINS=https://<你的域名>

# ── 判断 Agent（v1 不部署，保持 false 走降级日志）────
JUDGMENT_ENABLED=false
JUDGMENT_AGENT_URL=http://wo-judgment-agent:8080
JUDGMENT_AGENT_TOKEN=

# ── OSS 附件（可选，后续启用）────────────────────────
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── LLM（可选）──────────────────────────────────────
DASHSCOPE_API_KEY=

# ── 公司 OA 网页项目台账抓取（Playwright，可停用不配）────────
# 无内网/公网访问留空即可，「从 OA 同步项目」会返回明确报错而非假成功
OA_BASE_URL=https://oa.xh-service.com
OA_USERNAME=<OA账号>
OA_PASSWORD=<OA密码>
PROJECT_LEDGER_ACTIVE_STATUSES=执行中,待执行
PROJECT_LEDGER_CUSTOMID=97

# 注意：钉盘 / AI表格数据同步依赖 dws CLI 凭证包，
# 不走环境变量，见 DEPLOYMENT.md「dws 凭证（钉盘数据源）」一节。
